  "content": {
    "prompt": "Write Python code that sets temp to 68 and change to 5. If temp plus change is greater than or equal to 75, assign status the value 'Hot'. Else if temp minus change is less than 60, assign status the value 'Cold'. Otherwise, assign status the value 'Mild'. Print status.",
    "source_code": "temp = 68\nchange = 5\nif temp + change >= 75:\n    status = 'Hot'\nelif temp - change < 60:\n    status = 'Cold'\nelse:\n    status = 'Mild'\nprint(status)\n"
