  "content": {
    "prompt": "Write Python code that sets distance to 100 and time to 8. If distance divided by time is greater than 15, assign label the value 'Fast'. Else if distance divided by time is greater than 10, assign label the value 'Moderate'. Otherwise, assign label the value 'Slow'. Print label.",
    "source_code": "distance = 100\ntime = 8\nif distance / time > 15:\n    label = 'Fast'\nelif distance / time > 10:\n    label = 'Moderate'\nelse:\n    label = 'Slow'\nprint(label)\n"
